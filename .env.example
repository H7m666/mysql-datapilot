# ── MySQL DataPilot 环境配置 ──────────────

# ====== MySQL 配置 ======
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=datapilot
MYSQL_POOL_SIZE=10

# ====== LLM 配置 ======
# 支持 OpenAI / DeepSeek / 通义千问 / 智谱 / API 中转站 等兼容接口
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ====== 服务配置 ======
PORT=8000
ENV=production
CORS_ORIGINS=http://localhost:5173

# ====== 可选配置 ======
# API_TOKEN=your-secret-token   # 设置后需 Bearer Token 鉴权
# LLM_TEMPERATURE=0.1           # 模型温度，默认 0.1
LOG_LEVEL=INFO
